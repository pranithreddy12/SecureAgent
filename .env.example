# --- Core ---
DATABASE_URL=postgresql+asyncpg://secureagent:change-me@postgres:5432/secureagent
POSTGRES_USER=secureagent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secureagent
SECRET_KEY=generate-with-python-secrets-token-urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- LLM (optional; deterministic fallback when empty) ---
# LLM_PROVIDER: anthropic or mistral. LLM_MODEL empty picks that provider's default
# (claude-sonnet-5-5 / mistral-large-latest).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# --- Security tools ---
ZAP_URL=http://zap:8080
ZAP_API_KEY=change-me
NUCLEI_PATH=/usr/local/bin/nuclei

# --- Limits ---
MAX_SCAN_DURATION=1800
SCAN_TIMEOUT=30
MAX_CONCURRENT_SCANS=2
MAX_TARGETS_PER_USER=20
MAX_CRAWL_PAGES=200
MAX_CRAWL_DEPTH=3
REQUESTS_PER_SECOND=5

# --- Target safety ---
ALLOW_PRIVATE_TARGETS=false
TARGET_ALLOWLIST=

# --- Source audits: comma-separated absolute directories the server may analyse ---
SOURCE_ROOTS=
# Zip upload in the web UI (ADR-019): unpacked here, deleted with the project. Empty = disabled.
UPLOAD_DIR=
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=5000
MAX_UPLOAD_UNPACKED_MB=150

# --- Modes ---
DEMO_MODE=false
REPORTS_DIR=/app/reports

{
  "profile": {
    "purpose": "ecommerce",
    "expected_users": "10k-100k",
    "data_categories": ["pii", "payment"],
    "regions": ["IN", "EU"],
    "exposure": "internet",
    "description": "Demo marketplace for handmade goods"
  },
  "rules": [
    {
      "id": "admin-requires-auth",
      "type": "require_auth",
      "paths": ["/admin/*"],
      "description": "Administrative actions must be authenticated"
    },
    {
      "id": "orders-are-private",
      "type": "owner_scoped",
      "paths": ["/orders/*"],
      "description": "A customer may only read their own orders"
    }
  ]
}
